-def split_nonzero_and_zero_params(params):
-    nonzero_params = []
-    zero_params = []
-    for p in params:
-        if p.ndim >= 2 and float(p.detach().norm()) == 0.0:
-            zero_params.append(p)
-        else:
-            nonzero_params.append(p)
-    return nonzero_params, zero_params
