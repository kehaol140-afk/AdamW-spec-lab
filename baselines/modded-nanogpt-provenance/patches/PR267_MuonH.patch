-
-for p in model.parameters():
-    dist.broadcast(p.detach(), 0)
-# start the clock
-training_time = 0
-dist.barrier()
-t0 = time.perf_counter()
-for step in range(train_steps + 1):
-
-    # --------------- VALIDATION SECTION -----------------
-    if step == train_steps or step % 125 == 0:
-        # stop the clock
-        dist.barrier()
-        training_time += time.perf_counter() - t0
-        model.eval()
-        val_loss = 0
-        with torch.no_grad():
