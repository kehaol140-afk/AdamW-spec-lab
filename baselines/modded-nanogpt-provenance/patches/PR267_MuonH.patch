+            lr=matrix_lr,
+            betas=(args.h_beta1, args.h_beta2),
+            eps=args.h_eps,
+            hyperball_eps=args.h_hyperball_eps,
+        )
+        for group in h_optimizer.param_groups:
+            group["schedule_type"] = "h"
+        optimizers.append(h_optimizer)
+    if hidden_zero_params:
+        zero_optimizer = Muon(
